{
  "info": {
    "name": "Franquicia API v2 (microservicios)",
    "description": "v2: el monolito se separa en franquicia-service (8081), sucursal-service (8082) y producto-service (8083), cada uno con su MongoDB, comunicados por ActiveMQ (request-reply + circuit breaker). Los POST guardan el id devuelto en las variables de coleccion, de modo que la coleccion se puede ejecutar de arriba abajo con `docker compose up` en la carpeta microservicios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Franquicias",
      "item": [
        {
          "name": "Agregar franquicia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('franquiciaId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Franquicia Norte\"\n}"
            },
            "url": {
              "raw": "{{franquiciaUrl}}/api/v1/franquicias",
              "host": [
                "{{franquiciaUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "franquicias"
              ]
            },
            "description": "AgregarFranquiciaUseCase. Responde 201 con la cabecera Location, o 400 si el nombre esta vacio o supera los 100 caracteres."
          }
        },
        {
          "name": "Listar franquicias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{franquiciaUrl}}/api/v1/franquicias",
              "host": [
                "{{franquiciaUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "franquicias"
              ]
            },
            "description": "ObtenerFranquiciasUseCase. Responde 200 con las franquicias ordenadas por nombre."
          }
        },
        {
          "name": "Consultar franquicia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{franquiciaUrl}}/api/v1/franquicias/{{franquiciaId}}",
              "host": [
                "{{franquiciaUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "franquicias",
                "{{franquiciaId}}"
              ]
            },
            "description": "ObtenerFranquiciaUseCase. Responde 200, 404 si no existe, o 400 si el id no es un UUID valido."
          }
        },
        {
          "name": "Renombrar franquicia",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nombre\": \"Franquicia Sur\"\n}"
            },
            "url": {
              "raw": "{{franquiciaUrl}}/api/v1/franquicias/{{franquiciaId}}/nombre",
              "host": [
                "{{franquiciaUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "franquicias",
                "{{franquiciaId}}",
                "nombre"
              ]
            },
            "description": "RenombrarFranquiciaUseCase. Responde 200, 404 si no existe, o 400 si el nombre es invalido."
          }
        }
      ],
      "description": "Servicio: {{franquiciaUrl}}"
    },
